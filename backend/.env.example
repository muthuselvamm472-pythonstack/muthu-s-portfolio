# Environment Configuration for Django + Oracle DB
# Copy this to .env in the backend/ directory and fill in your Oracle credentials

# Django
DJANGO_SECRET_KEY=muthu-portfolio-secret-key-2026-change-this-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Oracle Database
# Fill in your Oracle credentials below:
ORACLE_USER=SYSTEM
ORACLE_PASSWORD=your_oracle_password_here
ORACLE_DSN=localhost:1521/ORCL

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_HOURS=8
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Admin Account (created via: python manage.py create_admin)
ADMIN_USERNAME=muthu
ADMIN_PASSWORD=Admin@2026

# CORS (allow React dev server)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
